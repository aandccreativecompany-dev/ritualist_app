<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#150C28"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prakriyā"
        android:textColor="#F2B93B"
        android:textStyle="bold"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_mantra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#E8DFFA"
        android:textStyle="italic"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_priority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_habits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#8A7BB5"
        android:maxLines="5"
        android:textSize="11sp" />

</LinearLayout>
